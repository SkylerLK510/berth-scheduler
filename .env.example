# Copy to .env.local for local development. Never commit real values.

# Database. Keep these commented out locally to use ./local.db (an empty value would not fall back).
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# Dispatcher sign-in (required in production; the app refuses writes without them).
DISPATCHER_PASSCODE=
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000

# Local development only: skip sign-in. Ignored in production.
# DEV_OPEN_WRITES=1
