# Copy to .env.local for local development. Never commit real values.

# Database. Keep these commented out locally to use ./local.db (an empty value would not fall back).
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=

# The site's exact origin. Required in production (https); optional locally.
APP_ORIGIN=http://localhost:3000

# First-admin setup at /setup, once. Remove both after the first admin exists.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_TOKEN=

# Local development only: skip sign-in. Ignored in production.
# DEV_OPEN_WRITES=1
